cat > postBuild << 'SCRIPT'
#!/bin/bash

echo "===== postBuild Script Starting ====="

mkdir -p ~/.R

# ~/.Rprofile'ında Sys.setenv() ile set et
cat > ~/.Rprofile << 'EOF'
# Set environment variables at R session level
Sys.setenv(
  R_MAX_MEM_SIZE = "4G",
  JAVA_OPTS = "-Xmx3g",
  R_TIMEOUT = "900"
)

# Set R options
options(
  java.parameters = "-Xmx3g",
  timeout = 900,
  pkgType = "binary",
  renv.consent = TRUE
)

message("\n✅ R Session Initialized: Memory=4G, Timeout=900s\n")
EOF

echo "✅ postBuild Script Complete"
SCRIPT

chmod +x postBuild