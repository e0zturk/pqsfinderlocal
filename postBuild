cat > postBuild << 'SCRIPT'
#!/bin/bash

echo "===== postBuild Script Starting ====="

mkdir -p ~/.R

# 1. Renviron dosyası (environment variables)
cat > ~/.R/Renviron << 'EOF'
R_MAX_MEM_SIZE=4G
JAVA_OPTS=-Xmx3g
R_TIMEOUT=900
EOF

# 2. Rprofile dosyası (R options + Renviron load)
cat > ~/.Rprofile << 'EOF'
# Load environment variables from ~/.R/Renviron
if (file.exists(path.expand("~/.R/Renviron"))) {
  readRenviron(path.expand("~/.R/Renviron"))
}

# Set R options
options(
  java.parameters = "-Xmx3g",
  timeout = 900,
  pkgType = "binary",
  renv.consent = TRUE
)

message("\n✅ R Session Initialized with 4GB Memory Configuration\n")
EOF

echo "✅ postBuild Script Complete"
SCRIPT

chmod +x postBuild