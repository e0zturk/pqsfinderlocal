#!/bin/bash

echo "===== postBuild Script Starting ====="
echo "Current working directory: $(pwd)"
echo "Current user: $(whoami)"
echo ""

echo "Creating ~/.R directory..."
mkdir -p ~/.R

echo "Creating ~/.R/Renviron with 4GB memory config..."
cat > ~/.R/Renviron << 'EOF'
R_MAX_MEM_SIZE=4G
JAVA_OPTS=-Xmx3g
R_TIMEOUT=900
EOF

echo "Creating ~/.Rprofile..."
cat > ~/.Rprofile << 'EOF'
options(
  java.parameters = "-Xmx3g",
  timeout = 900,
  pkgType = "binary",
  renv.consent = TRUE
)
EOF

echo ""
echo "===== postBuild Script Complete ====="
echo "Files created:"
ls -la ~/.R/
echo ""
